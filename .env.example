# Server Configuration
PORT=4000
NODE_ENV=development

# Security Mode: 'vulnerable' | 'secure' (can be overridden per-request via 'x-security-mode' header)
SECURITY_MODE=vulnerable

# SQLite Database Connection URL
DATABASE_URL="file:./dev.db"

# JWT Secret for Token Verification
JWT_SECRET=vaultguard-devsecops-super-secure-secret-key-2026
